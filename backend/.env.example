# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# Matches the credentials in ../docker-compose.yml
DATABASE_URL=postgresql+psycopg://kanban:kanban@localhost:5433/kanban

# HS256 signing key for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-this-is-not-a-real-secret

# Origin of the Vite dev server, for CORS.
CORS_ORIGINS=http://localhost:5173
